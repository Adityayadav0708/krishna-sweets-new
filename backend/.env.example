


# Server Port (Render sets this automatically; keep default for local)
PORT=5006

# Environment (set to "production" on Render, keep "development" locally)
NODE_ENV=development

# Allowed Frontend Origin — your Vercel URL in production
FRONTEND_URL=https://krishna-sweets-new.vercel.app

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# JWT Secrets for Authentication (use long random strings in production)
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY_ACCESS_TOKEN=your_access_token_secret_here
SECRET_KEY_REFRESH_TOKEN=your_refresh_token_secret_here

# Gmail SMTP for Email Verification & OTPs (NO custom domain required!)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Resend Email API Key (optional fallback, requires custom domain to send to non-owner emails)
RESEND_API_KEY=your_resend_api_key_here

# Cloudinary Credentials (for sweet photo uploads from Admin Portal)
CLODINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLODINARY_API_KEY=your_cloudinary_api_key
CLODINARY_API_SECRET_KEY=your_cloudinary_api_secret_key
