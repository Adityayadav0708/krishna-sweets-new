# ==============================================================
# KRISHNA SWEETS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env and fill in your actual production/local credentials.
# NEVER commit the actual .env file to Git!

# Server Port
PORT=5006

# Allowed Frontend Origin (for CORS and email redirects)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/E_COMMERCE

# JWT Secrets for Authentication
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY_ACCESS_TOKEN=your_access_token_secret_here
SECRET_KEY_REFRESH_TOKEN=your_refresh_token_secret_here

# Resend Email API Key (for transactional email verification)
RESEND_API_KEY=your_resend_api_key_here

# Cloudinary Credentials (for sweet photo uploads from Admin Portal)
CLODINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLODINARY_API_KEY=your_cloudinary_api_key
CLODINARY_API_SECRET_KEY=your_cloudinary_api_secret_key
